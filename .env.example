# RouteWise Configuration
# Copy this file to .env and fill in your values

# Application
APP_NAME=RouteWise
APP_VERSION=1.0.0
DEBUG=true
DEMO_MODE=true

# Security
SECRET_KEY=change-me-to-a-random-secret-key-at-least-32-chars
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Database
DATABASE_URL=postgresql+asyncpg://routewise:routewise@localhost:5432/routewise
# For local dev without PostgreSQL:
# DATABASE_URL=sqlite+aiosqlite:///./routewise.db

# Redis
REDIS_URL=redis://localhost:6379/0

# Celery
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# CORS
CORS_ORIGINS=["http://localhost:8000","http://localhost:3000"]

# PostGIS
POSTGIS_AVAILABLE=false

# Routing Engine (OSRM)
ROUTING_ENGINE_URL=

# Provider API Keys (leave empty for demo mode)
UBER_API_KEY=
OLA_API_KEY=
RAPIDO_API_KEY=
NAMMA_YATRI_API_KEY=

# Limits
MAX_WALKING_DISTANCE_M=2000
MAX_SEARCH_RADIUS_M=5000
DEFAULT_SEARCH_RADIUS_M=1500
RATE_LIMIT=60/minute

